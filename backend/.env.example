# Database
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/peelp_dev?schema=public"

# JWT
JWT_SECRET="your_jwt_secret_key_change_in_production"
JWT_EXPIRY="7d"

# Server
PORT=5000
NODE_ENV="development"

# Stripe
STRIPE_SECRET_KEY="sk_test_your_key_here"
STRIPE_PUBLISHABLE_KEY="pk_test_your_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Email (optional for future notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"

# Frontend URL(s) for CORS, comma-separated when using more than one origin
FRONTEND_URL="http://localhost:5173,http://localhost:5174,https://peaceful-emotion-production-d146.up.railway.app"

# Better Auth
BETTER_AUTH_SECRET="generate-a-strong-random-secret-here"
BETTER_AUTH_URL="https://peelp-production.up.railway.app"

# Admin User Credentials
ADMIN_EMAIL="your_admin_email@example.com"
ADMIN_PASSWORD="set-a-strong-password-here"
